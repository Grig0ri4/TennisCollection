<Window x:Class="TennisCatalog.DiaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мой Дневник" Height="650" Width="480" Background="#F0F8FF" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="МОИ МАТЧИ" FontSize="20" FontWeight="Bold" Foreground="#1E3A8A" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="DiaryCardsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#1E90FF" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="15">
                            <StackPanel>
                                <TextBlock Text="{Binding TournamentName}" FontWeight="Bold" Foreground="#1E90FF" FontSize="14" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding TourType, StringFormat='Тур: {0}'}" FontSize="11" Foreground="Gray" Margin="0,0,0,8"/>

                                <TextBlock Margin="0,2"><Run Text="Игрок 1: " FontWeight="SemiBold"/> <Run Text="{Binding Player1}"/></TextBlock>
                                <TextBlock Margin="0,2"><Run Text="Игрок 2: " FontWeight="SemiBold"/> <Run Text="{Binding Player2}"/></TextBlock>
                                <TextBlock Margin="0,2" Foreground="#32CD32"><Run Text="Победитель: " FontWeight="SemiBold"/> <Run Text="{Binding Winner}"/></TextBlock>
                                <TextBlock Margin="0,2"><Run Text="Счёт: " FontWeight="SemiBold"/> <Run Text="{Binding Score}"/></TextBlock>

                                <TextBlock Margin="0,5,0,0" FontStyle="Italic" Text="{Binding Notes, StringFormat='Заметка: {0}'}" Foreground="DarkSlateGray"/>
                                <TextBlock Text="{Binding Rating, StringFormat='Оценка: {0}/10'}" FontWeight="Bold" Foreground="#FF8C00"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="ЗАМЕТКИ" Click="EditNotes_Click" Tag="{Binding DiaryId}" Width="85" Margin="0,0,10,0" Background="#E3F2FD"/>
                                    <Button Content="УДАЛИТЬ" Click="RemoveMatch_Click" Tag="{Binding DiaryId}" Width="85" Background="#FFEBEE" Foreground="Red"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" Content="ЗАКРЫТЬ" Click="Close_Click" Width="120" Height="35" Margin="0,15,0,0" Background="#1E90FF" Foreground="White"/>
    </Grid>
</Window>