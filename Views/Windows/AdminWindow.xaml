<Window x:Class="TennisCatalog.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель Администратора" Height="750" Width="1000"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" Background="#F4F7F9">
    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="25,0"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#1E90FF"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="#E3F2FD" CornerRadius="14,14,0,0" Padding="22,12" Margin="4,0">
                            <ContentPresenter ContentSource="Header" TextBlock.FontWeight="SemiBold" x:Name="ContentSite"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#BBDEFB"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E90FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <TabControl Background="Transparent" BorderThickness="0">

            <TabItem Header="УПРАВЛЕНИЕ ФИНАЛАМИ">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="25" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Color="#000000" Opacity="0.05"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,15">
                                <TextBlock Text="ТУР"/>
                                <ComboBox x:Name="AdminFinalsTourComboBox" SelectionChanged="AdminFinalsTourComboBox_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,15">
                                <TextBlock Text="ГОД"/>
                                <TextBox x:Name="AdminFinalsYearTextBox" TextChanged="AdminFinalsYearTextBox_TextChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,15">
                                <TextBlock Text="СЧЁТ (напр: 6-4, 7-6(5))" Foreground="#3B82F6"/>
                                <TextBox x:Name="AdminFinalsScoreTextBox" ToolTip="Формат: 6-4, 6-3 или 7-6(5)"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,0,0,15">
                                <TextBlock Text="ТУРНИР"/>
                                <ComboBox x:Name="AdminFinalsTournamentComboBox" SelectionChanged="AdminFinalsTournamentComboBox_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="ИГРОК 1"/>
                                <ComboBox x:Name="AdminFinalsPlayer1ComboBox" IsEditable="True" IsTextSearchEnabled="False" TextBoxBase.TextChanged="AdminPlayerComboBox_TextChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="ИГРОК 2"/>
                                <ComboBox x:Name="AdminFinalsPlayer2ComboBox" IsEditable="True" IsTextSearchEnabled="False" TextBoxBase.TextChanged="AdminPlayerComboBox_TextChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="4">
                                <TextBlock Text="ПОБЕДИТЕЛЬ"/>
                                <ComboBox x:Name="AdminFinalsWinnerComboBox" IsEditable="True" IsTextSearchEnabled="False" TextBoxBase.TextChanged="AdminPlayerComboBox_TextChanged"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="5" Margin="0,0,0,20" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Color="#000000" Opacity="0.05"/>
                        </Border.Effect>
                        <DataGrid x:Name="AdminFinalsGrid" Style="{StaticResource ModernDataGrid}" SelectionChanged="AdminFinalsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="50"/>
                                <DataGridTextColumn Header="ГОД" Binding="{Binding year}" Width="60"/>
                                <DataGridTextColumn Header="ТУРНИР" Binding="{Binding tournament}" Width="*"/>
                                <DataGridTextColumn Header="ИГРОК 1" Binding="{Binding player1}" Width="*"/>
                                <DataGridTextColumn Header="ИГРОК 2" Binding="{Binding player2}" Width="*"/>
                                <DataGridTextColumn Header="ПОБЕДИТЕЛЬ" Binding="{Binding winner}" Width="*"/>
                                <DataGridTextColumn Header="СЧЁТ" Binding="{Binding score}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="ДОБАВИТЬ ФИНАЛ" Click="AdminAddFinalButton_Click" Background="#1565C0"/>
                        <Button Content="УДАЛИТЬ ФИНАЛ" Click="AdminDeleteFinalButton_Click" Background="#0D47A1"/>
                        <Button Content="ВЫЙТИ ИЗ АДМИНКИ" Click="AdminExitButton_Click" Background="#64748B"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="УПРАВЛЕНИЕ ИГРОКАМИ">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="25" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Color="#000000" Opacity="0.05"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ТУР"/>
                                <ComboBox x:Name="AdminPlayersTourComboBox" SelectionChanged="AdminPlayersTourComboBox_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ФИО ИГРОКА"/>
                                <TextBox x:Name="AdminPlayerFullNameTextBox" TextChanged="AdminPlayerFullNameTextBox_TextChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="СТРАНА"/>
                                <TextBox x:Name="AdminPlayerCountryTextBox" TextChanged="AdminPlayerCountryTextBox_TextChanged"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="5" Margin="0,0,0,20" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Color="#000000" Opacity="0.05"/>
                        </Border.Effect>
                        <DataGrid x:Name="AdminPlayersGrid" Style="{StaticResource ModernDataGrid}" SelectionChanged="AdminPlayersGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="100"/>
                                <DataGridTextColumn Header="ИМЯ" Binding="{Binding full_name}" Width="*"/>
                                <DataGridTextColumn Header="СТРАНА" Binding="{Binding country}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="ДОБАВИТЬ ИГРОКА" Click="AdminAddPlayerButton_Click" Background="#1565C0"/>
                        <Button Content="УДАЛИТЬ ИГРОКА" Click="AdminDeletePlayerButton_Click" Background="#0D47A1"/>
                        <Button Content="ВЫЙТИ ИЗ АДМИНКИ" Click="AdminExitButton_Click" Background="#64748B"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>