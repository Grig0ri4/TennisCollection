<Page x:Class="TennisCatalog.StatisticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Title="Статистика" Background="White">

    <Page.Resources>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <Button x:Name="BackButton" Content="← НАЗАД" Click="Back_Click" Width="80" Height="30" Background="#DDD" Style="{StaticResource RoundedButton}"/>
            <TextBlock x:Name="StatTitle" Text="Загрузка..." FontSize="20" FontWeight="Bold" Foreground="#1E3A8A" Margin="20,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <ComboBox x:Name="StatsTypeCombo" Grid.Row="1" Width="300" Height="30" HorizontalAlignment="Left" Margin="0,15,0,0" SelectionChanged="StatsTypeCombo_SelectionChanged" Visibility="Collapsed">
            <ComboBoxItem Content="Общее кол-во финалов по годам"/>
            <ComboBoxItem Content="Распределение по категориям"/>
        </ComboBox>

        <lvc:CartesianChart Grid.Row="2" x:Name="MainChart" Series="{Binding Series}" XAxes="{Binding XAxes}" Margin="0,20"/>
    </Grid>
</Page>